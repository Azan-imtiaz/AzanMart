{
  "name": "azanmart",
  "version": "1.0.0",
  "description": "AzanMart - a server-side rendered e-commerce store built with Express, EJS and MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "create-admin": "node scripts/createAdmin.js"
  },
  "keywords": [
    "ecommerce",
    "express",
    "ejs",
    "mongodb",
    "ssr",
    "nodejs"
  ],
  "author": "Azan Imtiaz (https://github.com/Azan-imtiaz)",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "debug": "^4.3.4",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-session": "^1.18.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.5",
    "morgan": "^1.12.1",
    "multer": "^1.4.5-lts.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azan-imtiaz/AzanMart.git"
  },
  "homepage": "https://github.com/Azan-imtiaz/AzanMart#readme",
  "bugs": {
    "url": "https://github.com/Azan-imtiaz/AzanMart/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}

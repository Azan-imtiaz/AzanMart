{
  "name": "azanmart",
  "version": "1.0.0",
  "description": "AzanMart - a server-side rendered e-commerce store built with Express, EJS and MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k -n css,app \"npm:watch:css\" \"node --watch server.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "create-admin": "node scripts/createAdmin.js",
    "build:css": "tailwindcss -i ./styles/app.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./styles/app.css -o ./public/css/app.css --watch",
    "build": "npm run build:css",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "keywords": [
    "ecommerce",
    "express",
    "ejs",
    "mongodb",
    "ssr",
    "nodejs"
  ],
  "author": "Azan Imtiaz (https://github.com/Azan-imtiaz)",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "chart.js": "^4.5.1",
    "compression": "^1.8.2",
    "connect-mongo": "^6.0.0",
    "debug": "^4.3.4",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "mongoose": "^8.3.5",
    "morgan": "^1.12.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.12",
    "remixicon": "^4.9.1",
    "sharp": "^0.35.5",
    "stripe": "^22.6.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azan-imtiaz/AzanMart.git"
  },
  "homepage": "https://github.com/Azan-imtiaz/AzanMart#readme",
  "bugs": {
    "url": "https://github.com/Azan-imtiaz/AzanMart/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}

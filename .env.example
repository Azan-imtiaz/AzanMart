NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
MONGODB_URL=mongodb://127.0.0.1:27017/azanmart
SESSION_SECRET=replace-with-a-long-random-string

# Optional: card payments (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: crypto payments in USDC. Set your wallet address to turn them on.
# Defaults use Base Sepolia, a free test network (no real money).
CRYPTO_RECEIVER_ADDRESS=
# CRYPTO_RPC_URL=https://sepolia.base.org
# CRYPTO_PUBLIC_RPC_URL=https://sepolia.base.org
# CRYPTO_CHAIN_ID=84532
# CRYPTO_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Optional: email. Without SMTP_HOST, emails are saved to temp files instead of sent.
# Gmail: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Defaults to your SMTP_USER address
MAIL_FROM=
# Or send through the Gmail API over HTTPS, for hosts that block SMTP (Render's free
# plan). Used instead of SMTP when all three are set; see docs/DEPLOYMENT.md.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional: the AI shopping assistant (key from https://build.nvidia.com)
NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Shows the demo banner and test payment details (set to false for a real store)
DEMO_MODE=true

<%- include('./partials/header') %>

<main id="main" class="flex-1 w-full max-w-4xl mx-auto px-5 py-12">
    <section class="card p-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-amber-600">About the developer</p>
        <h1 class="text-3xl font-bold text-blue-900 mt-1 dark:text-white">Azan Imtiaz</h1>
        <p class="muted mt-1">Software Engineering graduate &middot; MERN &amp; Blockchain developer</p>

        <p class="mt-6 leading-relaxed">
            Hi, I'm Azan. I built AzanMart to practise building a complete, server-rendered web store from the
            ground up: search and filters, a cart and checkout with Stripe, order emails, reviews, and an admin
            dashboard with sales charts, all rendered on the server with Node.js and MongoDB.
            I work mostly with the MERN stack and blockchain technologies, and I enjoy turning ideas into
            products people can actually use.
        </p>

        <div class="flex flex-wrap gap-3 mt-6">
            <a href="https://github.com/Azan-imtiaz" target="_blank" rel="noopener"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-gray-900 text-white hover:bg-gray-700">
                <i class="ri-github-fill"></i> GitHub
            </a>
            <a href="https://www.linkedin.com/in/azan-imtiaz" target="_blank" rel="noopener"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-700 text-white hover:bg-blue-800">
                <i class="ri-linkedin-box-fill"></i> LinkedIn
            </a>
            <a href="https://github.com/Azan-imtiaz/AzanMart" target="_blank" rel="noopener"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-gray-300 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800">
                <i class="ri-code-s-slash-line"></i> Source code
            </a>
        </div>
    </section>

    <section class="card p-8 mt-6">
        <h2 class="text-xl font-semibold text-blue-900 dark:text-white">How AzanMart is built</h2>
        <ul class="flex flex-wrap gap-2 mt-4">
            <% ["Node.js", "Express 5", "EJS (server-side rendering)", "MongoDB", "Mongoose", "Tailwind CSS", "Stripe", "Nodemailer", "Chart.js", "express-session", "bcrypt", "Helmet", "Multer"].forEach(function (tech) { %>
                <li class="px-3 py-1 rounded-full bg-blue-50 text-blue-900 text-sm dark:bg-blue-900/40 dark:text-blue-200"><%= tech %></li>
            <% }) %>
        </ul>
    </section>
</main>

<%- include('./partials/footer') %>

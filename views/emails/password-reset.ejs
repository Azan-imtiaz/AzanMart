<%- include('layout-top', { subject: "Reset your password" }) %>
<h1 style="margin:0 0 8px;font-size:20px;">Reset your password</h1>
<p style="margin:0 0 20px;color:#4b5563;line-height:1.5;">
  Hi <%= user.fullName.split(" ")[0] %>, we got a request to reset the password for your AzanMart account.
  This link works once and expires in one hour.
</p>
<p style="margin:0;">
  <a href="<%= resetUrl %>" style="display:inline-block;background:#1e3a8a;color:#ffffff;text-decoration:none;padding:10px 20px;border-radius:999px;font-weight:bold;">Choose a new password</a>
</p>
<p style="margin:20px 0 0;color:#6b7280;font-size:13px;line-height:1.5;">
  If you didn't ask for this, you can ignore this email. Your password won't change.
</p>
<%- include('layout-bottom') %>

<%- include('layout-top', { subject: `Order ${order.orderNumber} cancelled` }) %>
<h1 style="margin:0 0 8px;font-size:20px;">Your order has been cancelled</h1>
<p style="margin:0 0 16px;color:#4b5563;line-height:1.5;">
  Hi <%= user.fullName.split(" ")[0] %>, order <strong><%= order.orderNumber %></strong> has been cancelled.
  <% if (order.paymentStatus === "paid" && order.paymentMethod === "card") { %>
    Your card payment of <strong><%= formatPrice(order.total) %></strong> will be refunded to the same card. Refunds usually take 5 to 10 business days to appear.
  <% } else { %>
    You haven't been charged.
  <% } %>
</p>
<p style="margin:0 0 20px;color:#4b5563;font-size:14px;">If you didn't expect this or have any questions, just reply to this email.</p>
<%- include('order-summary', { order, buttonLabel: "View order details" }) %>
<%- include('layout-bottom') %>

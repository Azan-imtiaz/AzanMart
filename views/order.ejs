<%- include('./partials/header') %>

<main id="main" class="flex-1 max-w-4xl w-full mx-auto px-4 py-10">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold">Order <%= order.orderNumber %></h1>
            <p class="muted mt-1">Placed on <%= new Date(order.createdAt).toLocaleDateString("en-US", { dateStyle: "long" }) %></p>
        </div>
        <%- include('./partials/order-status', { status: order.status }) %>
    </div>

    <div class="mt-8 grid md:grid-cols-[1fr_280px] gap-6 items-start">
        <section class="card">
            <ul class="divide-y divide-gray-200 dark:divide-gray-800">
                <% order.items.forEach((item) => { %>
                    <li class="p-4 flex items-center gap-4">
                        <img src="<%= item.imageUrl %>" alt="" class="h-16 w-16 rounded-lg object-contain bg-gray-100 dark:bg-gray-800">
                        <div class="flex-1">
                            <% if (item.slug) { %>
                                <a href="/products/<%= item.slug %>" class="font-medium hover:underline"><%= item.name %></a>
                            <% } else { %>
                                <span class="font-medium"><%= item.name %></span>
                            <% } %>
                            <p class="text-sm muted"><%= formatPrice(item.price) %> &times; <%= item.quantity %></p>
                        </div>
                        <p class="font-medium"><%= formatPrice(item.price * item.quantity) %></p>
                    </li>
                <% }) %>
            </ul>
            <dl class="border-t border-gray-200 dark:border-gray-800 p-4 space-y-2 text-sm">
                <div class="flex justify-between"><dt class="muted">Subtotal</dt><dd><%= formatPrice(order.subtotal) %></dd></div>
                <div class="flex justify-between"><dt class="muted">Shipping</dt><dd><%= order.shipping === 0 ? "Free" : formatPrice(order.shipping) %></dd></div>
                <div class="flex justify-between text-base font-semibold"><dt>Total</dt><dd><%= formatPrice(order.total) %></dd></div>
            </dl>
        </section>

        <aside class="space-y-6">
            <section class="card p-5 text-sm">
                <h2 class="font-semibold">Shipping to</h2>
                <% const a = order.shippingAddress; %>
                <address class="not-italic mt-2 muted leading-relaxed">
                    <%= a.fullName %><br>
                    <%= a.line1 %><br>
                    <% if (a.line2) { %><%= a.line2 %><br><% } %>
                    <%= a.city %> <%= a.postalCode %><br>
                    <%= a.country %><br>
                    <%= a.phone %>
                </address>
            </section>
            <section class="card p-5 text-sm">
                <h2 class="font-semibold">Payment</h2>
                <p class="mt-2 muted">
                    <%= order.paymentMethod === "cod" ? "Cash on delivery" : "Card" %>
                    &middot; <%= order.paymentStatus === "paid" ? "Paid" : "Not paid yet" %>
                </p>
            </section>
        </aside>
    </div>

    <div class="mt-8 flex gap-3">
        <a href="/orders" class="btn btn-outline">All orders</a>
        <a href="/shop" class="btn btn-outline">Continue shopping</a>
    </div>
</main>

<%- include('./partials/footer') %>

<%- include('./partials/header') %>

<main class="flex-1 max-w-6xl w-full mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold">Your cart</h1>

    <% if (!cart.items.length) { %>
        <div class="card mt-8 p-12 text-center">
            <i class="ri-shopping-bag-3-line text-5xl muted"></i>
            <h2 class="text-xl font-semibold mt-3">Your cart is empty</h2>
            <p class="muted mt-1">Find something you like and it will show up here.</p>
            <a href="/shop" class="btn btn-primary mt-6">Start shopping</a>
        </div>
    <% } else { %>
        <div class="mt-8 grid lg:grid-cols-[1fr_340px] gap-8 items-start">
            <ul class="card divide-y divide-gray-200 dark:divide-gray-800">
                <% cart.items.forEach(({ product, quantity, lineTotal, inStock }) => { %>
                    <li class="p-4 sm:p-5 flex gap-4">
                        <a href="/products/<%= product.slug %>" class="h-24 w-24 shrink-0 rounded-lg flex items-center justify-center" style="background-color: <%= product.bgcolor %>">
                            <img src="<%= imageUrl(product) %>" alt="<%= product.name %>" class="max-h-20">
                        </a>
                        <div class="flex-1 min-w-0">
                            <div class="flex justify-between gap-4">
                                <div>
                                    <a href="/products/<%= product.slug %>" class="font-semibold hover:underline"><%= product.name %></a>
                                    <p class="text-sm muted"><%= formatPrice(product.finalPrice) %> each</p>
                                </div>
                                <p class="font-semibold"><%= formatPrice(lineTotal) %></p>
                            </div>

                            <% if (!inStock) { %>
                                <p class="mt-2 text-sm text-red-600">
                                    <%= product.stock === 0 ? "Out of stock. Please remove it to continue." : `Only ${product.stock} left. Please lower the quantity.` %>
                                </p>
                            <% } %>

                            <div class="mt-3 flex items-center gap-4">
                                <form action="/cart/items/<%= product._id %>/quantity" method="post" class="flex items-center gap-2" data-autosubmit>
                                    <%- include('./partials/csrf') %>
                                    <label for="qty-<%= product._id %>" class="text-sm muted">Qty</label>
                                    <input id="qty-<%= product._id %>" name="quantity" type="number" min="1" max="<%= Math.max(product.stock, 1) %>" value="<%= quantity %>" class="input w-20 py-1">
                                    <noscript><button type="submit" class="btn btn-outline py-1">Update</button></noscript>
                                </form>
                                <form action="/cart/items/<%= product._id %>/remove" method="post">
                                    <%- include('./partials/csrf') %>
                                    <button type="submit" class="text-sm text-red-600 hover:underline">Remove</button>
                                </form>
                            </div>
                        </div>
                    </li>
                <% }) %>
            </ul>

            <aside class="card p-6 lg:sticky lg:top-24">
                <h2 class="text-lg font-semibold">Order summary</h2>
                <dl class="mt-4 space-y-2 text-sm">
                    <div class="flex justify-between">
                        <dt class="muted">Subtotal (<%= cart.itemCount %> items)</dt>
                        <dd><%= formatPrice(cart.subtotal) %></dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="muted">Shipping</dt>
                        <dd><%= cart.shipping === 0 ? "Free" : formatPrice(cart.shipping) %></dd>
                    </div>
                    <div class="flex justify-between border-t border-gray-200 dark:border-gray-800 pt-3 text-base font-semibold">
                        <dt>Total</dt>
                        <dd><%= formatPrice(cart.total) %></dd>
                    </div>
                </dl>
                <% if (cart.shipping > 0) { %>
                    <p class="mt-3 text-xs muted">Add <%= formatPrice(freeShippingFrom - cart.subtotal) %> more for free shipping.</p>
                <% } %>
                <a href="/shop" class="btn btn-outline w-full mt-6">Continue shopping</a>
            </aside>
        </div>
    <% } %>
</main>

<%- include('./partials/footer') %>

<%- include('../partials/header') %>

<main class="flex-1 flex items-center justify-center px-4 py-16">
    <div class="card w-full max-w-md p-8">
        <h1 class="text-2xl font-bold">Choose a new password</h1>

        <form action="/reset-password/<%= token %>" method="post" class="mt-6 space-y-4">
            <%- include('../partials/csrf') %>
            <div>
                <label for="password" class="label">New password</label>
                <input id="password" name="password" type="password" autocomplete="new-password" minlength="6" required class="input">
            </div>
            <div>
                <label for="confirmPassword" class="label">Confirm new password</label>
                <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="6" required class="input">
            </div>
            <button type="submit" class="btn btn-primary w-full">Reset password</button>
        </form>
    </div>
</main>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<main id="main" class="flex-1 flex items-center justify-center px-4 py-16">
    <div class="card w-full max-w-md p-8">
        <h1 class="text-2xl font-bold">Create your account</h1>
        <p class="muted mt-1">It takes less than a minute.</p>

        <form action="/register" method="post" class="mt-6 space-y-4">
            <%- include('../partials/csrf') %>
            <div>
                <label for="fullname" class="label">Full name</label>
                <input id="fullname" name="fullname" type="text" autocomplete="name" maxlength="60" required class="input">
            </div>
            <div>
                <label for="email" class="label">Email</label>
                <input id="email" name="email" type="email" autocomplete="email" required class="input">
            </div>
            <div>
                <label for="password" class="label">Password</label>
                <input id="password" name="password" type="password" autocomplete="new-password" minlength="6" required class="input">
                <p class="text-xs muted mt-1">At least 6 characters.</p>
            </div>
            <button type="submit" class="btn btn-primary w-full">Create account</button>
        </form>

        <p class="mt-6 text-sm text-center muted">
            Already have an account? <a href="/login" class="font-medium text-blue-900 hover:underline dark:text-blue-300">Log in</a>
        </p>
    </div>
</main>

<%- include('../partials/footer') %>

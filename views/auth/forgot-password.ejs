<%- include('../partials/header') %>

<main id="main" class="flex-1 flex items-center justify-center px-4 py-16">
    <div class="card w-full max-w-md p-8">
        <h1 class="text-2xl font-bold">Forgot your password?</h1>
        <p class="muted mt-1">Enter your email and we'll send you a link to choose a new one.</p>

        <form action="/forgot-password" method="post" class="mt-6 space-y-4">
            <%- include('../partials/csrf') %>
            <div>
                <label for="email" class="label">Email</label>
                <input id="email" name="email" type="email" autocomplete="email" required class="input">
            </div>
            <button type="submit" class="btn btn-primary w-full">Send reset link</button>
        </form>

        <p class="mt-6 text-sm text-center muted">
            Remembered it? <a href="/login" class="font-medium text-blue-900 hover:underline dark:text-blue-300">Back to log in</a>
        </p>
    </div>
</main>

<%- include('../partials/footer') %>

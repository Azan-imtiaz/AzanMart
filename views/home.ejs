<%- include('./partials/header') %>

<main id="main" class="flex-1">
    <section class="bg-blue-900 text-white">
        <div class="max-w-6xl mx-auto px-4 py-16 sm:py-24 grid md:grid-cols-2 gap-10 items-center">
            <div>
                <p class="text-amber-400 font-semibold uppercase tracking-wide text-sm">New season collection</p>
                <h1 class="text-4xl sm:text-5xl font-bold mt-3 leading-tight">Everyday essentials, thoughtfully picked.</h1>
                <p class="mt-4 text-blue-100 text-lg max-w-md">Bags built for work, travel and everything in between.</p>
                <div class="mt-8 flex flex-wrap gap-3">
                    <a href="/shop" class="btn bg-amber-500 text-gray-950 hover:bg-amber-400">Shop now <i class="ri-arrow-right-line"></i></a>
                    <% if (!locals.currentUser) { %>
                        <a href="/register" class="btn border border-white/40 hover:bg-white/10">Create an account</a>
                    <% } %>
                </div>
            </div>
            <% if (newArrivals[0]) { %>
                <div class="hidden md:flex justify-center">
                    <div class="h-80 w-80 rounded-full flex items-center justify-center" style="background-color: <%= newArrivals[0].bgcolor %>">
                        <img src="<%= imageUrl(newArrivals[0]) %>" alt="<%= newArrivals[0].name %>" class="max-h-64">
                    </div>
                </div>
            <% } %>
        </div>
    </section>

    <section aria-label="Why shop with us" class="border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900/40">
        <ul class="max-w-6xl mx-auto px-4 py-5 grid grid-cols-2 lg:grid-cols-4 gap-4 text-sm">
            <% [["ri-truck-line", "Free shipping", "On orders over " + formatPrice(freeShippingFrom)], ["ri-secure-payment-line", "Pay your way", "Card, USDC crypto or cash"], ["ri-sparkling-2-line", "AI shopping assistant", "Ask in your own words"], ["ri-shield-check-line", "Secure checkout", "Stock held while you pay"]].forEach(([icon, title, text]) => { %>
                <li class="flex items-center gap-3">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-50 text-lg text-blue-900 dark:bg-blue-900/40 dark:text-blue-200"><i class="<%= icon %>"></i></span>
                    <span><span class="block font-semibold"><%= title %></span><span class="muted"><%= text %></span></span>
                </li>
            <% }) %>
        </ul>
    </section>

    <section class="max-w-6xl mx-auto px-4 py-12">
        <h2 class="text-2xl font-bold">Shop by category</h2>
        <div class="mt-6 grid grid-cols-2 lg:grid-cols-4 gap-4">
            <% categories.forEach((category) => { %>
                <a href="/shop?category=<%= encodeURIComponent(category) %>" class="card px-4 py-6 text-center font-medium hover:border-blue-900 dark:hover:border-blue-400">
                    <%= category %>
                </a>
            <% }) %>
        </div>
    </section>

    <section class="max-w-6xl mx-auto px-4 pb-16">
        <div class="flex items-end justify-between">
            <h2 class="text-2xl font-bold">New arrivals</h2>
            <a href="/shop" class="text-sm font-medium text-blue-900 hover:underline dark:text-blue-300">View all</a>
        </div>
        <% if (newArrivals.length) { %>
            <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <% newArrivals.forEach((product) => { %>
                    <%- include('./partials/product-card', { product }) %>
                <% }) %>
            </div>
        <% } else { %>
            <p class="mt-6 muted">New products are on their way. Check back soon.</p>
        <% } %>
    </section>
    <section class="bg-white dark:bg-gray-900/40 border-y border-gray-200 dark:border-gray-800">
        <div class="max-w-6xl mx-auto px-4 py-16">
            <div class="flex flex-wrap items-end justify-between gap-4">
                <div>
                    <p class="text-sm font-semibold uppercase tracking-wide text-amber-600">Pay your way</p>
                    <h2 class="mt-1 text-2xl sm:text-3xl font-bold">Card, crypto or cash: your choice</h2>
                </div>
                <a href="/features#payments" class="text-sm font-medium text-blue-900 hover:underline dark:text-blue-300">How payments work <i class="ri-arrow-right-line"></i></a>
            </div>
            <div class="mt-8 grid md:grid-cols-3 gap-5">
                <% [["ri-bank-card-line", "Card", "Secure checkout with Stripe. Your card details never touch our servers.", cardEnabled], ["ri-wallet-3-line", "USDC from your wallet", "Pay in a dollar stablecoin with MetaMask, verified on the blockchain.", cryptoEnabled], ["ri-hand-coin-line", "Cash on delivery", "Pay the courier when your order arrives. No card needed.", true]].forEach(([icon, title, text, on]) => { %>
                    <div class="card p-6">
                        <i class="<%= icon %> text-3xl text-blue-900 dark:text-blue-300"></i>
                        <h3 class="mt-3 font-semibold"><%= title %></h3>
                        <p class="mt-1 text-sm muted"><%= text %></p>
                        <% if (!on) { %><p class="mt-3 text-xs muted"><i class="ri-information-line"></i> Not switched on in this demo</p><% } %>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>

    <section class="max-w-6xl mx-auto px-4 py-16">
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-blue-950 via-blue-900 to-indigo-900 px-6 py-12 sm:px-12 text-white">
            <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-amber-400/20 blur-3xl" aria-hidden="true"></div>
            <div class="relative grid md:grid-cols-[1fr_auto] gap-8 items-center">
                <div>
                    <p class="inline-flex items-center gap-2 text-sm font-semibold text-amber-400"><i class="ri-sparkling-2-fill"></i> AI shopping assistant</p>
                    <h2 class="mt-2 text-2xl sm:text-3xl font-bold">Not sure which bag is right? Just ask.</h2>
                    <p class="mt-2 max-w-xl text-blue-100">"Something for my laptop and gym clothes under $100." The assistant searches our catalog and shows you products that fit.</p>
                </div>
                <% if (assistantEnabled) { %>
                    <button type="button" data-assistant-trigger class="btn bg-amber-400 text-gray-950 hover:bg-amber-300 px-6 py-3"><i class="ri-sparkling-2-fill"></i> Ask the assistant</button>
                <% } else { %>
                    <a href="/features#assistant" class="btn bg-amber-400 text-gray-950 hover:bg-amber-300 px-6 py-3">See how it works</a>
                <% } %>
            </div>
        </div>
    </section>

    <section class="max-w-6xl mx-auto px-4 pb-16">
        <div class="card p-8 sm:p-10 grid md:grid-cols-[1fr_auto] gap-6 items-center">
            <div>
                <h2 class="text-2xl font-bold">More than a shop window</h2>
                <p class="mt-2 muted max-w-2xl">Order tracking with email updates, reviews from verified buyers, a wishlist, dark mode, and an admin dashboard with live sales charts. Take a look at everything AzanMart can do.</p>
            </div>
            <div class="flex flex-wrap gap-3">
                <a href="/features" class="btn btn-primary">Explore all features</a>
                <a href="/guide" class="btn btn-outline">User guide</a>
            </div>
        </div>
    </section>
</main>

<%- include('./partials/footer') %>

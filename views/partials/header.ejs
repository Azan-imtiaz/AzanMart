<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%
        const pageTitle = typeof title !== "undefined" ? `${title} | AzanMart` : "AzanMart - Everyday essentials, thoughtfully picked";
        const pageDescription = typeof description !== "undefined" ? description : "AzanMart is an online store for bags and everyday essentials, built by Azan Imtiaz with Node.js, Express and MongoDB.";
        const pageUrl = appUrl + currentPath;
    %>
    <title><%= pageTitle %></title>
    <meta name="description" content="<%= pageDescription %>">
    <meta name="author" content="Azan Imtiaz">
    <meta name="theme-color" content="#1e3a8a">
    <link rel="canonical" href="<%= pageUrl %>">
    <link rel="icon" type="image/svg+xml" href="<%= asset("/favicon.svg") %>">

    <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
    <meta property="og:site_name" content="AzanMart">
    <meta property="og:title" content="<%= pageTitle %>">
    <meta property="og:description" content="<%= pageDescription %>">
    <meta property="og:url" content="<%= pageUrl %>">
    <meta property="og:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : appUrl + '/images/og-image.png' %>">
    <meta name="twitter:card" content="summary_large_image">
    <% if (typeof structuredData !== "undefined") { %>
        <script type="application/ld+json"><%- safeJson(structuredData) %></script>
    <% } %>
    <link rel="stylesheet" href="<%= asset("/vendor/remixicon/remixicon.css") %>">
    <script src="<%= asset("/js/theme.js") %>"></script>
    <link rel="stylesheet" href="<%= asset("/css/app.css") %>">
    <script src="<%= asset("/js/app.js") %>" defer></script>
</head>

<body class="font-sans antialiased text-gray-800 bg-gray-50 min-h-screen flex flex-col dark:bg-gray-950 dark:text-gray-100">
    <% if (demoMode) { %>
        <div data-demo-banner class="bg-gradient-to-r from-amber-400 to-amber-500 text-gray-950 text-sm">
            <div class="max-w-6xl mx-auto px-4 py-1.5 flex items-center justify-center gap-3 text-center">
                <span><i class="ri-flask-line"></i> <strong>Demo store:</strong> payments run in test mode, nothing is charged. <a href="/features#try-it" class="underline font-medium whitespace-nowrap">How to try it</a></span>
                <button type="button" data-dismiss-banner class="shrink-0 rounded p-0.5 hover:bg-black/10" aria-label="Hide this message"><i class="ri-close-line"></i></button>
            </div>
        </div>
    <% } %>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 btn btn-primary">Skip to content</a>
    <header class="sticky top-0 z-40 border-b border-gray-200 bg-white/90 backdrop-blur dark:border-gray-800 dark:bg-gray-950/90">
        <nav class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between gap-4" aria-label="Main">
            <a href="/" class="shrink-0" aria-label="AzanMart home">
                <img src="<%= asset("/images/logo.svg") %>" alt="AzanMart" width="147" height="36" class="h-7 sm:h-9 w-auto dark:hidden">
                <img src="<%= asset("/images/logo-dark.svg") %>" alt="AzanMart" width="147" height="36" class="h-7 sm:h-9 w-auto hidden dark:block">
            </a>

            <form action="/shop" method="get" role="search" class="hidden md:block flex-1 max-w-sm">
                <label for="site-search" class="sr-only">Search products</label>
                <div class="relative">
                    <i class="ri-search-line absolute left-3 top-1/2 -translate-y-1/2 muted"></i>
                    <input id="site-search" name="q" type="search" placeholder="Search products" class="input rounded-full pl-9 py-1.5">
                </div>
            </form>

            <div class="flex items-center gap-3 sm:gap-6 text-sm font-medium whitespace-nowrap">
                <a href="/shop" class="hidden min-[360px]:inline hover:text-blue-900 dark:hover:text-blue-300">Shop</a>
                <a href="/features" class="hidden sm:inline hover:text-blue-900 dark:hover:text-blue-300">Features</a>
                <a href="/guide" class="hidden md:inline hover:text-blue-900 dark:hover:text-blue-300">Guide</a>

                <button type="button" data-theme-toggle class="text-xl hover:text-blue-900 dark:hover:text-blue-300" aria-label="Toggle dark mode">
                    <i class="ri-moon-line dark:hidden"></i>
                    <i class="ri-sun-line hidden dark:inline"></i>
                </button>

                <% if (locals.currentUser) { %>
                    <a href="/cart" class="relative text-xl hover:text-blue-900 dark:hover:text-blue-300" aria-label="Cart, <%= cartCount %> items">
                        <i class="ri-shopping-bag-3-line"></i>
                        <% if (cartCount > 0) { %>
                            <span class="absolute -top-1.5 -right-2 min-w-5 h-5 px-1 rounded-full bg-amber-500 text-white text-xs flex items-center justify-center"><%= cartCount %></span>
                        <% } %>
                    </a>

                    <details class="relative" data-menu>
                        <summary class="list-none cursor-pointer flex items-center gap-1 hover:text-blue-900 dark:hover:text-blue-300">
                            <i class="ri-user-3-line text-xl"></i>
                            <span class="hidden sm:inline"><%= currentUser.fullName.split(" ")[0] %></span>
                            <i class="ri-arrow-down-s-line"></i>
                        </summary>
                        <div class="card absolute right-0 mt-2 w-48 py-2 text-sm">
                            <% if (currentUser.role === "admin") { %>
                                <a href="/admin" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-800">Admin</a>
                            <% } %>
                            <a href="/account" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-800">Account</a>
                            <a href="/orders" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-800">My orders</a>
                            <a href="/cart" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-800">Cart</a>
                            <a href="/wishlist" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-800">Wishlist</a>
                            <form action="/logout" method="post">
                                <%- include("./csrf") %>
                                <button type="submit" class="w-full text-left px-4 py-2 text-red-600 hover:bg-gray-100 dark:hover:bg-gray-800">Log out</button>
                            </form>
                        </div>
                    </details>
                <% } else { %>
                    <a href="/login" class="hover:text-blue-900 dark:hover:text-blue-300">Log in</a>
                    <a href="/register" class="btn btn-primary py-1.5 px-3 sm:px-5">Sign up</a>
                <% } %>
            </div>
        </nav>
    </header>

    <% if (locals.currentUser && currentUser.emailVerified === false && currentPath !== "/verify-email") { %>
        <div class="bg-amber-50 text-amber-900 text-sm dark:bg-amber-900/30 dark:text-amber-100">
            <div class="max-w-6xl mx-auto px-4 py-2 flex flex-wrap items-center justify-between gap-2">
                <span><i class="ri-mail-unread-line"></i> Please verify your email address to place orders.</span>
                <a href="/verify-email" class="font-semibold underline">Verify now</a>
            </div>
        </div>
    <% } %>

    <%- include("./flash") %>

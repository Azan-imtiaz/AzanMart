<%- include('./partials/shell-top') %>

<a href="/admin/orders" class="text-sm muted hover:underline">&larr; All orders</a>
<div class="mt-2 flex flex-wrap items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold">Order <%= order.orderNumber %></h1>
        <p class="muted text-sm mt-1">Placed <%= new Date(order.createdAt).toLocaleString("en-US", { dateStyle: "medium", timeStyle: "short" }) %></p>
    </div>
    <%- include('../partials/order-status', { status: order.status }) %>
</div>

<div class="mt-6 grid lg:grid-cols-[1fr_300px] gap-6 items-start">
    <section class="card">
        <ul class="divide-y divide-gray-200 dark:divide-gray-800">
            <% order.items.forEach((item) => { %>
                <li class="p-4 flex items-center gap-4 text-sm">
                    <img src="<%= item.imageUrl %>" alt="" class="h-12 w-12 rounded object-contain bg-gray-100 dark:bg-gray-800">
                    <span class="flex-1 font-medium"><%= item.name %></span>
                    <span class="muted"><%= formatPrice(item.price) %> &times; <%= item.quantity %></span>
                    <span class="w-20 text-right font-medium"><%= formatPrice(item.price * item.quantity) %></span>
                </li>
            <% }) %>
        </ul>
        <dl class="border-t border-gray-200 dark:border-gray-800 p-4 space-y-1 text-sm">
            <div class="flex justify-between"><dt class="muted">Subtotal</dt><dd><%= formatPrice(order.subtotal) %></dd></div>
            <div class="flex justify-between"><dt class="muted">Shipping</dt><dd><%= order.shipping === 0 ? "Free" : formatPrice(order.shipping) %></dd></div>
            <div class="flex justify-between font-semibold"><dt>Total</dt><dd><%= formatPrice(order.total) %></dd></div>
        </dl>
    </section>

    <aside class="space-y-4">
        <section class="card p-5">
            <h2 class="font-semibold">Update status</h2>
            <% if (["delivered", "cancelled"].includes(order.status)) { %>
                <p class="text-sm muted mt-2">This order is <%= order.status %> and can no longer change.</p>
            <% } else { %>
                <form action="/admin/orders/<%= order.orderNumber %>/status" method="post" class="mt-3 space-y-3">
                    <%- include('../partials/csrf') %>
                    <label for="status" class="sr-only">Status</label>
                    <select id="status" name="status" class="input">
                        <% statuses.forEach((s) => { %>
                            <option value="<%= s %>" <%= s === order.status ? "selected" : "" %>><%= s[0].toUpperCase() + s.slice(1) %></option>
                        <% }) %>
                    </select>
                    <button type="submit" class="btn btn-primary w-full">Save</button>
                    <p class="text-xs muted">Shipped sends the customer an email. Cancelled puts the items back in stock<%= order.paymentStatus === "paid" && order.paymentMethod === "card" ? "; refund the card payment from the Stripe dashboard" : "" %>.</p>
                </form>
            <% } %>
        </section>

        <section class="card p-5 text-sm">
            <h2 class="font-semibold">Customer</h2>
            <p class="mt-2"><%= order.user ? order.user.fullName : "Deleted account" %></p>
            <% if (order.user) { %><p class="muted"><%= order.user.email %></p><% } %>
            <% const a = order.shippingAddress; %>
            <address class="not-italic mt-3 muted leading-relaxed">
                <%= a.fullName %><br><%= a.line1 %><br><% if (a.line2) { %><%= a.line2 %><br><% } %><%= a.city %> <%= a.postalCode %><br><%= a.country %><br><%= a.phone %>
            </address>
        </section>

        <section class="card p-5 text-sm">
            <h2 class="font-semibold">Payment</h2>
            <p class="mt-2 muted"><%= order.paymentMethod === "cod" ? "Cash on delivery" : "Card (Stripe)" %> &middot; <%= order.paymentStatus %></p>
            <% if (order.paidAt) { %><p class="muted">Paid <%= new Date(order.paidAt).toLocaleString("en-US", { dateStyle: "medium", timeStyle: "short" }) %></p><% } %>
        </section>
    </aside>
</div>

<%- include('./partials/shell-bottom') %>

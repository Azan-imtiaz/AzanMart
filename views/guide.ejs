<%- include('./partials/header') %>

<main id="main" class="flex-1 max-w-6xl w-full mx-auto px-4 py-10">
    <div class="rounded-2xl bg-gradient-to-br from-blue-950 via-blue-900 to-indigo-900 px-6 py-10 sm:px-10 text-white">
        <p class="text-sm font-semibold uppercase tracking-wide text-amber-400">Help centre</p>
        <h1 class="mt-2 text-3xl sm:text-4xl font-bold"><%= guide.title %></h1>
        <p class="mt-2 max-w-2xl text-blue-100">Everything you need to shop, pay, track an order, or run the store from the admin area.</p>
        <div class="mt-6 flex flex-wrap gap-3">
            <a href="/features#try-it" class="btn bg-amber-400 text-gray-950 hover:bg-amber-300">Demo logins &amp; test card</a>
            <a href="/features" class="btn border border-white/30 hover:bg-white/10">See all features</a>
        </div>
    </div>

    <div class="mt-10 grid lg:grid-cols-[230px_1fr] gap-10 items-start">
        <nav aria-label="Guide contents" class="lg:sticky lg:top-24">
            <details class="card lg:border-0 lg:shadow-none lg:bg-transparent group" open data-guide-toc>
                <summary class="lg:hidden cursor-pointer list-none px-4 py-3 font-medium flex justify-between">
                    Contents <i class="ri-arrow-down-s-line transition group-open:rotate-180"></i>
                </summary>
                <ol class="px-4 pb-4 lg:p-0 space-y-1 text-sm">
                    <% guide.toc.forEach((item) => { %>
                        <li class="<%= item.depth === 3 ? 'pl-4' : 'pt-2 font-semibold' %>">
                            <a href="#<%= item.id %>" class="block rounded px-2 py-1 hover:bg-gray-100 hover:text-blue-900 dark:hover:bg-gray-800 dark:hover:text-blue-300 <%= item.depth === 3 ? 'muted' : '' %>"><%= item.text %></a>
                        </li>
                    <% }) %>
                </ol>
            </details>
        </nav>

        <article class="card p-6 sm:p-10 min-w-0 prose prose-slate max-w-none dark:prose-invert prose-headings:scroll-mt-24 prose-a:text-blue-900 dark:prose-a:text-blue-300 prose-img:rounded-xl prose-img:border prose-img:border-gray-200 dark:prose-img:border-gray-800 prose-table:text-sm prose-th:text-left">
            <%- guide.html %>
        </article>
    </div>
</main>

<%- include('./partials/footer') %>
